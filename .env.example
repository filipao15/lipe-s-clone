# ============================================================================
# 1. Credenciais do Telegram (obtenha em https://my.telegram.org -> API development tools)
# ============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=seu_api_hash_aqui
TELEGRAM_SESSION_NAME=meu_clone_session

# ============================================================================
# 2. Chave da API do Google Gemini (obtenha grátis em https://aistudio.google.com/apikey)
# ============================================================================
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# 3. Comportamento e Segurança do Userbot
# ============================================================================
# Tempo (em segundos) que o bot espera a pessoa parar de digitar antes de responder
# (assim, se a pessoa mandar 3 mensagens seguidas, ele lê todas juntas!)
DEBOUNCE_SECONDS=4.0

# Se você digitar manualmente em uma conversa, quantos minutos o bot pausa naquele chat
MANUAL_INTERVENTION_PAUSE_MINUTES=30

# Lista de IDs ou @usernames permitidos (deixe vazio para responder a todos os chats privados)
# Exemplo: ALLOWED_USERS=@amigo1,@amigo2,123456789
ALLOWED_USERS=

# Lista de IDs ou @usernames bloqueados (onde o bot NUNCA deve responder)
# Exemplo: BLOCKED_USERS=@chefe,@banco
BLOCKED_USERS=
